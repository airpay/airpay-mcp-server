# === Airpay Credentials (Required) ===
AIRPAY_MERCHANT_ID=your_merchant_id
AIRPAY_USERNAME=your_username
AIRPAY_PASSWORD=your_password
AIRPAY_SECRET=your_secret_key
AIRPAY_CLIENT_ID=your_client_id
AIRPAY_CLIENT_SECRET=your_client_secret

# === Server Configuration ===
# Streamable HTTP transport (MCP spec 2025-03-26) — recommended for all deployments
TRANSPORT=http

# Port for HTTP transport
PORT=8888

# MCP endpoint: http://localhost:8888/mcp

# Environment: sandbox | production
ENVIRONMENT=sandbox

# Comma-separated list of enabled toolsets, or "all"
# Available: payments, refunds, qr_upi, subscriptions
TOOLSETS=all

# Restrict to read-only tools only (true/false)
READ_ONLY=false

# Log file path (empty = stderr)
LOG_FILE=

# Log level: debug | info | warn | error
LOG_LEVEL=info
