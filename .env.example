# === Airpay Credentials (Required) ===
AIRPAY_MERCHANT_ID=your_merchant_id
AIRPAY_USERNAME=your_username
AIRPAY_PASSWORD=your_password
AIRPAY_SECRET=your_secret_key
AIRPAY_CLIENT_ID=your_client_id
AIRPAY_CLIENT_SECRET=your_client_secret
PAYMENT_DOMAIN=https://yourstore.com

# === Server Configuration ===
# Streamable HTTP transport (MCP spec 2025-03-26) — recommended for all deployments
TRANSPORT=http

# Port for HTTP transport
PORT=8888

# MCP endpoint: http://localhost:8888/mcp

# Environment: sandbox | production
ENVIRONMENT=sandbox

# Comma-separated list of enabled toolsets, or "all"
# Available: payments, refunds, qr_upi, subscriptions
TOOLSETS=all

# Restrict to read-only tools only (true/false)
READ_ONLY=false

# Log file path (empty = stderr)
LOG_FILE=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# === QR Preview Links (Optional) ===
# Any string — SHA-256 hashed internally to produce a 32-byte AES-256-GCM key.
# When set, airpay_generate_qr returns a view_qr_page URL served at /qr/{token}/preview.
# If not set, the tool still works but no preview link is returned.
QR_MASTER_KEY=any-secret-string-you-choose

# Base URL of this server used to build QR preview links.
# Defaults to http://localhost:{PORT} if not set.
MCP_SERVER_URL=http://localhost:8888

# How long (in seconds) a QR preview link stays valid. Default: 86400 (24h).
QR_LINK_TTL=86400
